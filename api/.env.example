SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Supabase > Project Settings > Database > Connection string (use the pooler URI)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Only if your project still uses the legacy JWT secret (Settings > API > JWT Settings).
# Leave EMPTY if your project uses the new signing keys; Django then reads the public keys from SUPABASE_URL.
SUPABASE_JWT_SECRET=
RATE_PER_HOUR=1000
CLIENT_URL=http://localhost:3000
